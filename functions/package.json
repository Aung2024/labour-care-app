{
  "name": "labour-care-functions",
  "description": "Cloud Functions for Labour Care App - Admin email update",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell --project mnch-1cbda",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --project mnch-1cbda",
    "logs": "firebase functions:log --project mnch-1cbda",
    "test": "node --test test/leaderboard-scoring.test.js",
    "test:rules": "firebase emulators:exec --only firestore,auth \"node --test test/firestore-rules.test.js\"",
    "test:integration": "firebase emulators:exec --project mnch-v2-functions-test --only functions,firestore,auth \"node --test test/leaderboard-functions.integration.test.js\""
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.26.0"
  },
  "private": true
}
