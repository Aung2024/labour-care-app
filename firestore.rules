rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isEditSupervisor() {
      return currentUserExists()
        && currentUserData().role in ["TMO", "Super Admin", "admin"];
    }

    function canSuperviseEditRequest(data) {
      return isEditSupervisor()
        && (
          currentUserData().role in ["Super Admin", "admin"]
          || (
            currentUserData().role == "TMO"
            && currentUserData().township == data.township
          )
        );
    }

    function canReadLeaderboardProvider(providerId) {
      return currentUserExists()
        && (
          currentUserData().role in ["Super Admin", "Central", "admin"]
          || request.auth.uid == providerId
          || (
            currentUserData().role == "Regional Officer"
            && currentUserData().region == resource.data.region
          )
          || (
            currentUserData().role in ["TMO", "Midwife", "midwife"]
            && currentUserData().township == resource.data.township
          )
        );
    }

    function canReadQualityProvider(providerId) {
      return currentUserExists()
        && (
          currentUserData().role in ["Super Admin", "Central", "admin"]
          || request.auth.uid == providerId
          || (
            resource != null
            && currentUserData().role == "Regional Officer"
            && currentUserData().region == resource.data.region
          )
          || (
            resource != null
            && currentUserData().role == "TMO"
            && currentUserData().township == resource.data.township
          )
        );
    }

    function isQualitySupervisor() {
      return currentUserExists()
        && currentUserData().role in ["TMO", "Regional Officer", "Super Admin", "Central", "admin"];
    }

    function canSuperviseQualityProvider(providerId) {
      return isQualitySupervisor()
        && (
          currentUserData().role in ["Super Admin", "Central", "admin"]
          || (
            currentUserData().role == "Regional Officer"
            && exists(/databases/$(database)/documents/users/$(providerId))
            && get(/databases/$(database)/documents/users/$(providerId)).data.region == currentUserData().region
          )
          || (
            currentUserData().role == "TMO"
            && exists(/databases/$(database)/documents/users/$(providerId))
            && get(/databases/$(database)/documents/users/$(providerId)).data.township == currentUserData().township
          )
        );
    }

    function qualityPlanProviderId(planId) {
      return planId.matches('.*_all$')
        ? planId[0:planId.size() - 4]
        : (planId.size() > 8 ? planId[0:planId.size() - 8] : '');
    }

    function canReadQualityPlan(planId) {
      return signedIn()
        && (
          qualityPlanProviderId(planId) == request.auth.uid
          || canSuperviseQualityProvider(qualityPlanProviderId(planId))
        );
    }

    function canReadQualityPlanData() {
      return signedIn()
        && resource != null
        && resource.data.providerId is string
        && (
          resource.data.providerId == request.auth.uid
          || canSuperviseQualityProvider(resource.data.providerId)
        );
    }

    function canReadAnalyticsScope() {
      return currentUserExists()
        && (
          currentUserData().role in ["Super Admin", "Central", "admin"]
          || (
            currentUserData().role in ["Midwife", "midwife"]
            && resource.data.scopeType == "provider"
            && resource.data.providerId == request.auth.uid
          )
          || (
            currentUserData().role == "TMO"
            && (
              (
                resource.data.scopeType == "township"
                && resource.data.township == currentUserData().township
              )
              || (
                resource.data.scopeType == "provider"
                && resource.data.township == currentUserData().township
              )
            )
          )
          || (
            currentUserData().role == "Regional Officer"
            && resource.data.region == currentUserData().region
            && resource.data.scopeType in ["region", "township", "provider"]
          )
        );
    }

    // Users collection
    match /users/{userId} {
      // Allow users to read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow Super Admin to read/write all user data
      allow read, write: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
        
      // Allow TMO to read users in their township (must check TMO role)
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "TMO"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.township == resource.data.township;
      
      // Allow all authenticated users to read basic user info for leaderboard
      allow read: if request.auth != null;
      
      // Explicit allow for Regional Officer to read users (leaderboard - midwives in their region)
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Regional Officer";
    }
    
    // Patient Counters collection (for patient ID generation)
    match /patient_counters/{counterId} {
      allow read, write: if request.auth != null;
    }
    
    // Patients collection
    // Mother and baby patients both live here. Baby records use
    // patient_type == "baby", mother_patient_id, and baby_patient_ids links.
    // Midwives on the care team (care_team_midwife_ids) must be able to write
    // delivery notes and create baby patients for joint-care / transferred mothers.
    match /patients/{patientId} {
      // Allow public read for share links (summary-view.html - clinicians share patient summary URLs)
      allow read: if true;
      // Allow authenticated users to read/write patient documents
      allow read, write: if request.auth != null;
      
      // Allow access to plotData subcollection
      match /plotData/{plotId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to records subcollection (summary, startingTime, secondStage, birthRecord)
      match /records/{recordId} {
        // Allow public read for share links (summary-view.html)
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Allow access to medication subcollection
      match /medication/{medicationId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to antenatal_visits subcollection
      match /antenatal_visits/{visitId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to testRecords subcollection
      match /testRecords/{testId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to test_records subcollection (alternative naming)
      match /test_records/{testId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to immediate_newborn_care subcollection
      match /immediate_newborn_care/{careId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to newborn_care subcollection
      match /newborn_care/{careId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to postpartum_visits subcollection
      match /postpartum_visits/{visitId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to baby_records subcollection
      match /baby_records/{recordId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to labour_care subcollection
      match /labour_care/{recordId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to lab_tests subcollection
      match /lab_tests/{testId} {
        allow read, write: if request.auth != null;
      }
      
      // Allow access to consents subcollection (patient consent records)
      match /consents/{consentId} {
        allow read: if request.auth != null;
        allow write: if
          request.auth != null
          && (
            request.resource.data.providerId == request.auth.uid
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin"
            )
          );
      }
      
      // Catch-all for any other subcollections under patients
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Patient transfer requests between midwives
    match /patient_transfer_requests/{requestId} {
      allow read, create, update: if request.auth != null;
      allow delete: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
    }

    // Joint Care links are stored under the linked midwife UID so reads are rule-friendly.
    match /joint_care_links/{midwifeId} {
      allow read, write: if false;

      match /patients/{patientId} {
        allow read: if
          request.auth != null
          && request.auth.uid == midwifeId;
        allow create: if
          request.auth != null
          && request.auth.uid == midwifeId
          && request.resource.data.linkedMidwifeId == request.auth.uid
          && request.resource.data.patientId == patientId
          && request.resource.data.status == "active";
        allow update: if
          request.auth != null
          && request.auth.uid == midwifeId
          && (
            !('linkedMidwifeId' in request.resource.data)
            || request.resource.data.linkedMidwifeId == request.auth.uid
          )
          && (
            !('patientId' in request.resource.data)
            || request.resource.data.patientId == patientId
          );
        allow read: if
          request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["Super Admin", "admin"];
        allow delete: if
          request.auth != null
          && (
            request.auth.uid == midwifeId
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["Super Admin", "admin"]
            )
          );
      }
    }

    // One-visit edit approval requests for TMO review.
    match /visit_edit_requests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || canSuperviseEditRequest(resource.data)
        );
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.used == false;
      // A supervisor can only review a pending request in their scope.
      allow update: if canSuperviseEditRequest(resource.data)
        && resource.data.status == "pending"
        && resource.data.requesterId != request.auth.uid
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.used == false
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewerRole == currentUserData().role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "reviewedBy", "reviewedAt", "reviewerRole", "rejectionReason"
        ]);
      // The requester consumes an approval; clinical form code does this in the
      // same transaction as the visit update.
      allow update: if signedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == "approved"
        && resource.data.used == false
        && request.resource.data.status == "used"
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "used", "usedBy", "usedAt"
        ]);
      // Preserve repeat requests after rejection or use, without allowing a
      // requester to overwrite an active approval.
      allow update: if signedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status in ["pending", "rejected", "used"]
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.visitType == resource.data.visitType
        && request.resource.data.visitId == resource.data.visitId
        && request.resource.data.status == "pending"
        && request.resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "patientName", "patientUniqueId", "ownerMidwifeId", "township",
          "region", "visitNumber", "visitDate", "requesterEmail", "reason",
          "status", "used", "requestedAt", "updatedAt"
        ]);
      allow delete: if false;
    }
    
    // Provider Consents collection
    match /provider_consents/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
    }
    
    // Feedback collection
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
      allow read: if request.auth != null && resource.data.submittedBy == request.auth.uid;
    }
    
    // Audit Logs collection
    match /audit_logs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow create: if
        request.resource.data.unauthenticated == true
        && request.resource.data.action in ['login_failed', 'account_locked'];
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Account Lockouts collection
    match /account_lockouts/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
      allow delete: if request.auth != null;
    }
    
    // Password History collection
    match /password_history/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Super Admin password reset queue (processed by Cloud Function trigger)
    match /admin_password_resets/{requestId} {
      allow create: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin"
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.userId is string
        && request.resource.data.newPassword is string;
      allow read: if
        request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Super Admin";
      allow update, delete: if false;
    }

    // Version 2 derived leaderboard summaries. Cloud Functions use Admin SDK
    // and bypass these rules; browser clients can never write derived data.
    match /leaderboard_v2_months/{month} {
      allow read: if signedIn();
      allow write: if false;

      match /providers/{providerId} {
        allow read: if canReadLeaderboardProvider(providerId);
        allow write: if false;
      }
    }

    match /leaderboard_v2_contributions/{contributionId} {
      allow read, write: if false;
    }

    match /leaderboard_v2_jobs/{jobId} {
      allow read, write: if false;
    }

    match /leaderboard_v3_daily/{summaryId} {
      allow read, write: if false;
    }

    // Aggregate-only Dashboard V2 summaries. Patient contributions and job
    // checkpoints remain server-only.
    match /analytics_v2_periods/{period} {
      allow read: if signedIn();
      allow write: if false;

      match /scopes/{scopeId} {
        allow read: if canReadAnalyticsScope();
        allow write: if false;
      }
    }

    match /analytics_v2_contributions/{contributionId} {
      allow read, write: if false;
    }

    match /analytics_v2_jobs/{jobId} {
      allow read, write: if false;
    }

    // Offline-safe refresh queues. They contain patient IDs and refresh
    // metadata only; scheduled Functions process and delete entries.
    match /tracking_v2_refresh_queue/{patientId} {
      allow create, update: if signedIn()
        && request.resource.data.patientId == patientId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'patientId', 'requestedBy', 'reason', 'updatedAt'
        ]);
      allow read, delete: if false;
    }

    match /leaderboard_v3_refresh_queue/{patientId} {
      allow create, update: if signedIn()
        && request.resource.data.patientId == patientId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'patientId', 'requestedBy', 'reason', 'updatedAt'
        ]);
      allow read, delete: if false;
    }

    // Patient-level tracking projections are available only through callable
    // APIs, which enforce role scope and pagination server-side.
    match /tracking_v2_hrt/{rowId} {
      allow read, write: if false;
    }

    match /tracking_v2_kmc/{rowId} {
      allow read, write: if false;
    }

    match /tracking_v2_jobs/{jobId} {
      allow read, write: if false;
    }

    // Quality Improvement V1 — server-derived monthly provider summaries.
    match /quality_improvement_v1_months/{month} {
      allow read: if signedIn();
      allow write: if false;

      match /providers/{providerId} {
        allow read: if canReadQualityProvider(providerId);
        allow write: if false;
      }
    }

    match /quality_improvement_v1_contributions/{contributionId} {
      allow read, write: if false;
    }

    // Midwife-authored monthly reasons/targets and supervisor comments.
    match /quality_improvement_plans/{planId} {
      allow read: if canReadQualityPlanData() || canReadQualityPlan(planId);
      allow create: if signedIn()
        && request.resource.data.providerId is string
        && request.resource.data.scoreMonth is string
        && planId == request.resource.data.providerId + '_' + request.resource.data.scoreMonth
        && (
          request.resource.data.providerId == request.auth.uid
          || canSuperviseQualityProvider(request.resource.data.providerId)
        );
      allow update: if signedIn()
        && resource.data.providerId is string
        && (
          (
            resource.data.providerId == request.auth.uid
            && request.resource.data.providerId == request.auth.uid
            && planId == request.auth.uid + '_' + request.resource.data.scoreMonth
          )
          || (
            canSuperviseQualityProvider(resource.data.providerId)
            && request.resource.data.providerId == resource.data.providerId
            && request.resource.data.scoreMonth == resource.data.scoreMonth
          )
        );
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if canReadQualityPlan(planId);
        allow create: if signedIn()
          && canSuperviseQualityProvider(qualityPlanProviderId(planId))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.indicatorId is string
          && request.resource.data.text is string;
        allow update, delete: if false;
      }
    }
  }
}
